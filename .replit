modules = ["python-3.11", "nodejs-24", "postgresql-16"]

[[ports]]
localPort = 5173
externalPort = 80

[[ports]]
localPort = 5174
externalPort = 3000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18115
externalPort = 3001

  [deployment]
  deploymentTarget = "autoscale"
  run = ["sh", "-c", "node --enable-source-maps artifacts/api-server/dist/index.mjs"]

  [agent]
expertMode = true

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
EXPO_PUBLIC_DOMAIN = "story-time-safe--haanipyd.replit.app"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
  