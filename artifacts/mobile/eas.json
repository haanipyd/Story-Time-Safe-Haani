{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "env": {
          "EXPO_PUBLIC_DOMAIN": "story-time-safe--haanipyd.replit.app"
        }
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "env": {
          "EXPO_PUBLIC_DOMAIN": "story-time-safe--haanipyd.replit.app"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
}
